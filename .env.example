# Supabase project URL
SUPABASE_URL=https://onpgahywhveksleripxc.supabase.co

# Use the publishable key in frontend only if needed. It is not sufficient for privileged server writes.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_OYGdRC1anbWtZ6IZJ9pLOA_mdv1_0qN

# REQUIRED for server-side Storage + database writes. Keep secret; never put this in HTML/JS or Git.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret

# Must be at least 32 random bytes for any future HMAC-based stable tokenization.
PII_HMAC_KEY=replace_with_a_long_random_secret
SUPABASE_BUCKET=masked-files
MAX_UPLOAD_MB=25
PORT=5000
